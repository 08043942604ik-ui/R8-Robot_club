#pragma once

#include <array>
#include <chrono>
#include <memory>

#include <rclcpp/rclcpp.hpp>

#include "titan.h"
#include "VMXPi.h"

// 左右のタイヤエンコーダーを20msごとに読み取るROS2ノード
class Encoderma : public rclcpp::Node {
 public:
  Encoderma();
  ~Encoderma() override;

  // 左M3、右M2の走行距離[m]を返す
  std::array<double, 2> RLDistance();


  void setSpeed(uint8_t motor, double speed);

  // 全モーターを停止する
  void StopAll();


  // 20msごとに呼ばれ、60秒後の停止と値の表示を行う
  void callback();

 private:
  std::shared_ptr<VMXPi> vmx_;
  std::unique_ptr<studica_driver::Titan> titan_;
  rclcpp::TimerBase::SharedPtr timer_;

  double TotalDistance = 0.0;
};
